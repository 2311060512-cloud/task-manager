# ==========================================================
# Task Manager - Environment Variables Configuration Template
# Sao chép file này thành .env và điền thông tin thực tế.
# KHÔNG BAO GIỜ commit file .env chứa thông tin bí mật lên Git!
# ==========================================================

# Secret key cho JWT (Tối thiểu 32 ký tự / 256-bit trong môi trường Production)
JWT_SECRET=your_production_secure_jwt_secret_must_be_at_least_32_characters

# Cấu hình Database PostgreSQL
POSTGRES_DB=taskdb
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_db_password

# Port cấu hình
SERVER_PORT=8080
POSTGRES_PORT=5432
